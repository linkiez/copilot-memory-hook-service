{
  "name": "copilot-memory-hook-service",
  "version": "0.1.0",
  "private": false,
  "description": "Standalone memory hook service and HTTP CLI for GitHub Copilot hook workflows.",
  "type": "module",
  "bin": {
    "memory-cycle-hook": "scripts/memory-cycle.js",
    "mcp-memory-http-cli": "scripts/mcp-memory-http-cli.js"
